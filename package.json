{
  "name": "gitlab-copilot-ci",
  "version": "1.1.20",
  "type": "module",
  "module": "app/main.ts",
  "private": true,
  "repository": "https://github.com/mashirozx/gitlab-copilot-ci",
  "scripts": {
    "dev": "bun run app/main.ts",
    "build:darwin-arm64": "bun run ./scripts/build-with-version.ts bun-darwin-arm64",
    "build:darwin-x64": "bun run ./scripts/build-with-version.ts bun-darwin-x64",
    "build:linux-x64": "bun run ./scripts/build-with-version.ts bun-linux-x64",
    "build:linux-arm64": "bun run ./scripts/build-with-version.ts bun-linux-arm64",
    "build:linux-x64-musl": "bun run ./scripts/build-with-version.ts bun-linux-x64-musl",
    "build:linux-arm64-musl": "bun run ./scripts/build-with-version.ts bun-linux-arm64-musl",
    "build:win-x64": "bun run ./scripts/build-with-version.ts bun-windows-x64",
    "build:win-arm64": "bun run ./scripts/build-with-version.ts bun-windows-arm64",
    "test": "bun test",
    "typecheck": "tstyche --target 6.0.3",
    "tsc": "tsc",
    "lint": "biome check .",
    "biome": "biome check . --fix && biome format --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "release": "bun run ./scripts/release.ts",
    "commit": "bun run ./scripts/commit.ts"
  },
  "dependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@gitbeaker/rest": "43.8.0",
    "@types/bun": "1.3.14",
    "@types/yargs": "17.0.35",
    "consola": "3.4.2",
    "husky": "9.1.7",
    "tablemark": "4.1.0",
    "temporal-polyfill": "1.0.4",
    "tstyche": "7.2.3",
    "typescript": "7.0.2",
    "yargs": "18.1.0"
  }
}
